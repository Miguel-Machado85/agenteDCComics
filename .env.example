# .env de DESARROLLO LOCAL. Para la EC2 usa deploy/env.prod.example
# (ver deploy/README.md).

# --- Base de datos (compose.yml) ---
POSTGRES_USER=dcagent
POSTGRES_PASSWORD=clave-secreta
POSTGRES_DB=dcagent

# Desde maquina local (scripts y backend local). Dentro de Docker el host es "db".
# Usa 127.0.0.1 y no "localhost": en Windows con Docker Desktop, "localhost" puede
# tardar minutos en conectar (intenta IPv6 primero) y cada request del backend se cuelga.
DB_PORT=55432
DATABASE_URL=postgresql://dcagent:clave-secreta@127.0.0.1:55432/dcagent

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Keycloak (compose.yml) ---
# Base de Keycloak dentro del mismo Postgres (la crea el servicio keycloak-db-init)
KEYCLOAK_DB=keycloak
KEYCLOAK_PORT=8080
# Admin de la consola de Keycloak (solo desarrollo)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Issuer esperado en el token: lo que ve el navegador
KEYCLOAK_ISSUER=http://localhost:8080/realms/dc-comics
# De donde el backend baja las llaves publicas (127.0.0.1, ver nota de la base).
# Backend en Docker: http://keycloak:8080/realms/dc-comics/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=http://127.0.0.1:8080/realms/dc-comics/protocol/openid-connect/certs
# Audiencia (aud) que debe traer el token
KEYCLOAK_AUDIENCE=dc-api
# Cliente publico que usa Swagger (/docs) para el login PKCE
KEYCLOAK_CLIENT_ID=dc-frontend

# --- LLM (Ollama) ---
OLLAMA_PORT=11434
# Si usas Ollama instalado en Windows, es el mismo valor
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
# Ventana de contexto. Ollama trunca en silencio con el valor por defecto
LLM_NUM_CTX=8192

# --- Agente ---
# Chunks con similitud menor al umbral se descartan
SIMILARITY_THRESHOLD=0.70
RETRIEVAL_TOP_K=10
# Criterio "strong retrieval": se genera aunque el grader del LLM diga que no
STRONG_MIN_CHUNKS=3
STRONG_TOP1=0.82
STRONG_TOP3_AVG=0.78
# Cuantos chunks entran al prompt de generate
MAX_CHUNKS_PROMPT=10
# Turnos previos del historial que usa rewrite_query
HISTORY_TURNS=3
# Buscar tambien con la pregunta original (util si la reescritura en ingles sale mal)
SEARCH_ORIGINAL_QUESTION=true
# Generar en ingles y traducir la respuesta cuando la pregunta no esta en ingles (+1 llamada al LLM)
TRANSLATE_ANSWERS=true

# --- API ---
BACKEND_PORT=8000
# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
# Tamano maximo de un archivo subido
MAX_UPLOAD_MB=10
# true: carga el modelo de embeddings al arrancar (la primera pregunta no espera)
PRELOAD_EMBEDDINGS=false

# --- Frontend (Vite). Solo las VITE_* llegan al navegador: nunca pongas secretos con ese prefijo ---
# Aqui va "localhost" y no 127.0.0.1: el navegador pide el token a esta URL y el
# issuer del token debe coincidir con KEYCLOAK_ISSUER del backend.
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=dc-comics
VITE_KEYCLOAK_CLIENT_ID=dc-frontend
# Opcional: segundos que el chat espera la respuesta de POST /chat (por defecto 600).
# En la EC2 una pregunta puede pasar de 3 min y Ollama atiende una a la vez
# (OLLAMA_NUM_PARALLEL=1); Caddy corta a los 600 s (read_timeout).
# VITE_CHAT_TIMEOUT_S=600
