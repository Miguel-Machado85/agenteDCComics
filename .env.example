# --- Base de datos (compose.yml) ---
POSTGRES_USER=dcagent
POSTGRES_PASSWORD=clave-secreta
POSTGRES_DB=dcagent

# Desde maquina local (scripts y backend local). Dentro de Docker el host es "db".
DB_PORT=55432
DATABASE_URL=postgresql://dcagent:clave-secreta@localhost:55432/dcagent

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384