# Reverse proxy con HTTPS automatico (Let's Encrypt).
# DOMAIN viene de compose.prod.yml, p. ej. 3-87-12-45.sslip.io; sslip.io
# resuelve api.3-87-12-45.sslip.io a 3.87.12.45 sin configurar nada.

api.{$DOMAIN} {
	encode gzip
	reverse_proxy backend:8000 {
		# Con 2 vCPU una pregunta puede pasar de 3 min (medido en la EC2);
		# con menos Caddy corta con 504 aunque el backend termine y guarde
		transport http {
			read_timeout 600s
		}
	}
}

auth.{$DOMAIN} {
	reverse_proxy keycloak:8080
}
