# .env de PRODUCCION (EC2). En la instancia:
#   cp deploy/env.prod.example .env && nano .env
# Cambia los valores marcados con CAMBIAR. Nunca subas el .env al repo.

# --- Docker Compose ---
# Con esto "docker compose ..." usa los dos archivos sin escribir -f
COMPOSE_FILE=compose.yml:compose.prod.yml
COMPOSE_PROJECT_NAME=agentedccomics

# --- Dominio publico ---
# IP publica con guiones + sslip.io. deploy/update-ip.sh lo rellena solo.
# Quedan: https://api.<DOMAIN> (API y Swagger) y https://auth.<DOMAIN> (Keycloak)
DOMAIN=CAMBIAR.sslip.io
# URL del frontend (fase 4, Netlify). Vacio por ahora.
FRONTEND_URL=

# --- Base de datos ---
POSTGRES_USER=dcagent
POSTGRES_PASSWORD=CAMBIAR-clave-larga-db
POSTGRES_DB=dcagent
DB_PORT=55432
# Solo para scripts que corren en el HOST de la EC2 (restaurar, cargarPgvector).
# El contenedor del backend usa "db:5432" (lo fija compose.yml).
DATABASE_URL=postgresql://dcagent:CAMBIAR-clave-larga-db@127.0.0.1:55432/dcagent

# --- Embeddings: deben ser IGUALES a los de la base cargada ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Keycloak ---
KEYCLOAK_DB=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
# Solo se aplica en el PRIMER arranque de Keycloak (crea el admin)
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR-clave-larga-admin
# KEYCLOAK_ISSUER y KC_HOSTNAME los arma compose.prod.yml a partir de DOMAIN
KEYCLOAK_AUDIENCE=dc-api
KEYCLOAK_CLIENT_ID=dc-frontend

# --- LLM (Ollama) ---
OLLAMA_PORT=11434
LLM_MODEL=qwen2.5:3b
LLM_NUM_CTX=8192

# --- Agente (mismos valores que en local) ---
SIMILARITY_THRESHOLD=0.70
RETRIEVAL_TOP_K=10
STRONG_MIN_CHUNKS=3
STRONG_TOP1=0.82
STRONG_TOP3_AVG=0.78
MAX_CHUNKS_PROMPT=10
# Con strong retrieval no se llama al grader del LLM (ahorra ~30 s por pregunta)
SKIP_GRADER_IF_STRONG=true
HISTORY_TURNS=3
SEARCH_ORIGINAL_QUESTION=true
TRANSLATE_ANSWERS=true

# --- API ---
BACKEND_PORT=8000
# Agrega aqui la URL de Netlify en la fase 4 (separadas por coma)
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
# En produccion si: la primera pregunta no espera a cargar el modelo
PRELOAD_EMBEDDINGS=true
